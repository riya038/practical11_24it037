{
  "name": "practical-12-cicd-github-actions",
  "version": "1.0.0",
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions and Automated Testing",
  "scripts": {
    "test": "npm --prefix backend test",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:ps": "docker ps",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:events": "cd backend && npm run test:events",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "github-actions",
    "ci-cd",
    "jest",
    "supertest",
    "automated-testing",
    "docker",
    "docker-compose",
    "practical12"
  ],
  "author": "24IT037",
  "license": "ISC"
}
